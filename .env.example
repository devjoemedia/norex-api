# Copy to .env for local dev. NEVER commit real secrets — production values come
# from the secret manager (see docs/00-backend-setup.md).

NODE_ENV=development
PORT=3001

# PostgreSQL (matches docker-compose.yml). In production the API must connect as the
# restricted norex_app role (prisma/roles.sql) so row-level security is enforced;
# run db push, db:guards, db:rls and the seed scripts with the owner's URL instead.
DATABASE_URL=postgresql://norex:norex@localhost:5432/norex?schema=public
# Direct (non-pooled) owner connection for `prisma db push` and the SQL setup scripts.
# Locally the same as DATABASE_URL. On Neon: the host WITHOUT "-pooler", as neondb_owner.
DIRECT_URL=postgresql://norex:norex@localhost:5432/norex?schema=public

# Redis (cache / OTP / throttling / queues)
REDIS_URL=redis://localhost:6379

# Auth — scaffold uses HS256 for easy local boot.
# PRODUCTION: switch to RS256 asymmetric keys (see docs/01 & docs/02).
JWT_SECRET=change-me-dev-only-not-for-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# CORS: comma-separated allowlist of tenant origins (no wildcard)
CORS_ORIGINS=http://localhost:3000,http://gambia.localhost:3000,http://ghana.localhost:3000

# Rate limiting (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Object storage (S3-compatible; MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=norex-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# One-time super-admin bootstrap (used only by `npm run bootstrap:admin`).
# Set, run once, then unset. Never commit a real password.
BOOTSTRAP_ADMIN_EMAIL=ops@norex.gm
BOOTSTRAP_ADMIN_PASSWORD=change-this-strong-password
BOOTSTRAP_ADMIN_TENANT=hq

# Website → API guest applications (docs/16). The website's server sends this as
# X-Web-Key; set the same value as NOREX_API_KEY in norex-web. Unset = intake off.
WEB_INTAKE_KEY=change-me-dev-web-intake-key-0000

# Website that serves device photos (catalog stores paths like /devices/x.png).
DEVICE_IMAGE_BASE_URL=http://localhost:3000
